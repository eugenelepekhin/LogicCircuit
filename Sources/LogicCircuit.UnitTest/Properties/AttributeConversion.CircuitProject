		<Note>include "CPU.inc.asm"

; reads key pressed by user in r1
macro ReadKey {
	li	waitPress, r2
	li	waitRelease, r3
	li	1 &lt;&lt; 14, r0		; port number for key
; wait till user press a key
waitPress:
	mov	[r0], r1
	or	r1, r1
	jp	[r2]			;waitPress

; wait till user release a key
waitRelease:
	mov	[r0], r2
	or	r2, r2
	jn	[r3]			;waitRelease
}

macro CALL {
	li		end, re	; save return address in re
	jmp		[rf]	; jump to function
end:
}

macro RET {
	jmp		[re]	; jump to return address
}

; This program is a simple calculator that reads key presses and performs operations based on the key pressed.
; The calculator supports addition, subtraction, multiplication, division, and negation.
; The calculator uses a simple key mapping to determine which operation to perform based on the key pressed.
; Register layout:
; r4, r5 - previous result
; r6, r7 - currently entering number
; rf - address of the operation to be executed
macro Calc {
; reset registers if RAM registers is used
	xor32	r4, r4
	xor32	r6, r6
	xor32	rb, rb
	xor		r8, r8
	xor		r9, r9
	xor		ra, ra

	li		addExecution, rf			; the default operation is addition

readKey:
	ReadKey
	li		0xF, r0						; suppress all bits but the last 4, to get the key code
	and		r0, r1
	li		KeyMapTable, r0				; get address of the pressed command
	add		r0, r1
	mov		[r1], r0
	jmp		[r0]

AddDigit:
; r1 contains the digit to add
; note that current number is positive
; first save current number in case of overflow.
	mov32	r6, ra					; save current number in ra
	li		AddDigitOverflow, r2	; address of overflow handler

; Now multiply current number to 10 and add the digit
	shl32	r6						; current * 2
	jn		[r2]					; check for overflow: the negative result is the overflow
	mov32	r6, r8					; (r8, r9) = current * 2
	shl32	r6						; current * 4
	jn		[r2]					; check for overflow: the negative result is the overflow
	shl32	r6						; current * 8
	jn		[r2]					; check for overflow: the negative result is the overflow
	add32	r8, r6					; current = current * 8 + current * 2, so it's current * 10
	jn		[r2]					; check for overflow: the negative result is the overflow
	li		0, r0
	add		r1, r6					; adding digit to current number
	adc		r0, r7
	jn		[r2]					; check for overflow: the negative result is the overflow

; now the current number is added to the new value
	mov32	r6, rb					; call the conversion to BCD

showResult:
; output it to the screen
	Bin2BCD		
	ST		r8, 0					; store lower BCD digits in lower port of the screen
	ST		r9, 1					; store middle BCD digits
	ST		ra, 2					; store higher BCD digits and sign of the number
	JMP		readKey					; wait for next key press

AddDigitOverflow:
	mov32	ra, r6					; restore current number in r6
	JMP		readKey					; wait for next key press

EqualOperation:
	CALL							; call currently stored operation
	li		equalExecution, rf		; store the operation to be executed
	mov32	r4, rb					; prepare to call the conversion to BCD
	xor32	r6, r6					; clear the current number
	JMP		showResult				; show the result

equalExecution:
	xor32	r6, r6					; clear the current number
	RET

AddOperation:
	CALL							; call currently stored operation
	li		addExecution, rf		; store the operation to be executed
	mov32	r4, rb					; prepare to call the conversion to BCD
	xor32	r6, r6					; clear the current number
	JMP		showResult				; show the result

addExecution:
	add32	r6, r4					; add the current number to the previous result
	xor32	r6, r6					; clear the current number
	mov32	r4, rb					; prepare to call the conversion to BCD
	RET
	

SubOperation:
	CALL							; call currently stored operation
	li		subExecution, rf		; store the operation to be executed
	mov32	r4, rb					; prepare to call the conversion to BCD
	xor32	r6, r6					; clear the current number
	JMP		showResult				; show the result

subExecution:
	sub32	r6, r4					; subtract the current number from the previous result
	xor32	r6, r6					; clear the current number
	mov32	r4, rb					; prepare to call the conversion to BCD
	RET

NegOperation:
	CALL
	li		addExecution, rf		; store the operation to be executed
	neg32	r4						; negate the previous result
	mov32	r4, rb					; prepare to call the conversion to BCD
	xor32	r6, r6					; clear the current number
	JMP		showResult				; show the result

MulOperation:
	CALL							; call currently stored operation
	li		mulExecution, rf		; store the operation to be executed
	mov32	r4, rb					; prepare to call the conversion to BCD
	xor32	r6, r6					; clear the current number
	JMP		showResult				; show the result

mulExecution:
	Mul32
	mov32	r8, r4					; set the previous result to the multiplication result
	mov32	r8, rb					; prepare to call the conversion to BCD
	xor32	r6, r6					; clear the current number
	RET


DivOperation:
	CALL							; call currently stored operation
	li		digExecution, rf		; store the operation to be executed
	mov32	r4, rb					; prepare to call the conversion to BCD
	xor32	r6, r6					; clear the current number
	JMP		showResult				; show the result

digExecution:
; swap (r4, r5) with (r6, r7)
	mov32	r6, r2					; save the current number in r2
	mov32	r4, r6					; move the current number to (r4, r5)
	mov32	r2, r4					; move the previous result to (r6, r7)

	Div32
	mov32	r6, r4					; set the previous result to the multiplication result
	mov32	r6, rb					; prepare to call the conversion to BCD
	xor32	r6, r6					; clear the current number
	RET


Digit7:
	li		7, r1
	JMP		AddDigit

Digit4:
	li		4, r1
	JMP		AddDigit

Digit1:
	li		1, r1
	JMP		AddDigit

Digit8:
	li		8, r1
	JMP		AddDigit

Digit5:
	li		5, r1
	JMP		AddDigit

Digit2:
	li		2, r1
	JMP		AddDigit

Digit0:
	li		0, r1
	JMP		AddDigit

Digit9:
	li		9, r1
	JMP		AddDigit

Digit6:
	li		6, r1
	JMP		AddDigit

Digit3:
	li		3, r1
	JMP		AddDigit

KeyMapTable:
	Digit7				;key 0 digit 7
	Digit4				;key 1 digit 4
	Digit1				;key 2 digit 1
	NegOperation		;key 3 neg sign
	Digit8				;key 4 digit 8
	Digit5				;key 5 digit 5
	Digit2				;key 6 digit 2
	Digit0				;key 7 digit 0
	Digit9				;key 8 digit 9
	Digit6				;key 9 digit 6
	Digit3				;key A digit 3
	EqualOperation		;key B =
	DivOperation		;key C /
	MulOperation		;key D *
	SubOperation		;key E -
	AddOperation		;key F +
}

macro main {
	Calc
}</Note>
