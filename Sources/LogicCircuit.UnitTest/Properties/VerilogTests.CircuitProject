		<Note>&lt;FlowDocument TextAlignment="Left" PagePadding="5,0,5,0" AllowDrop="True" NumberSubstitution.CultureSource="User" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"&gt;&lt;Paragraph&gt;// Verilog Test Bench&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;module CPU_TestBench;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	reg Clock;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	reg Reset;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	wire [15:0]outData;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	wire [15:0]Adr;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	wire Halt;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	int count, i;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	// CPU(8, 7)&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	CPU_test cpu_test(&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		.Clk(Clock),&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		.Res(Reset),&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		.outD(outData),&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		.Adr(Adr),&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		.Hlt(Halt)&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	task  printRegisters();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		begin&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("---- Registers: ----");&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("Flags=%4b, IP=%0h", cpu_test.CPU_7x6.Register_4_bits_27x15.q, cpu_test.CPU_7x6.IP_16_27x23.q);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("r0=%0x", cpu_test.CPU_7x6.Register_Block_16_27x8.Register_Block_4_24x2.Registers_16_bits_20x3.q);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("r1=%0x", cpu_test.CPU_7x6.Register_Block_16_27x8.Register_Block_4_24x2.Registers_16_bits_20x9.q);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("r2=%0x", cpu_test.CPU_7x6.Register_Block_16_27x8.Register_Block_4_24x2.Registers_16_bits_20x15.q);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("r3=%0x", cpu_test.CPU_7x6.Register_Block_16_27x8.Register_Block_4_24x2.Registers_16_bits_20x21.q);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("---- ----");&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	endtask //printRegisters&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	task printMemory();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		begin&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("---- Memory: ----");&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			for(i = 0; i &amp;lt; 10; i++) begin&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;				$display("Memory[%0d]=%0h", i, cpu_test.CPU_test_RAM_14x4_14x4.memory[i]);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("---- ----");&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	endtask //printMemory&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	task printCommand();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		begin&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt; command mem[%0h] = %0h", Adr, cpu_test.CPU_test_RAM_14x4_14x4.memory[Adr[7:0]]);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			printRegisters();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	endtask //printCommand&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	task printState();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		begin&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("&amp;gt;&amp;gt;&amp;gt;&amp;gt; reg source=%0h, regs=%2h", cpu_test.CPU_7x6.Pin13x23, cpu_test.CPU_7x6.Pin14x23);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			printRegisters();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			printMemory();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	endtask //printState&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	task printCycle(int cycle);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		begin&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			// if(cpu_test.CPU_7x6.Pin10x17 == 'hf000) begin&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			// 	$display("&amp;gt;&amp;gt;&amp;gt;&amp;gt; cycle=%0d, command=%0h", cycle, cpu_test.CPU_7x6.Pin10x17);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			// 	printState();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			// end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	endtask //printCycle&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	initial begin&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		$display("=== Starting CPU_TestBench");&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		Clock = 0;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		Reset = 0;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		$display("Reset=0, Halt=%d, Adr=%0h, outData=%0h, count=%0d", Halt, Adr, outData, count);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;		count = 0;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		Reset = 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		while(cpu_test.CPU_7x6.Pin10x24 == 0) begin&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			Clock = 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			Clock = 0;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			count = count + 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("Waiting for cpu clock to get to senses: %0d", count);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		count = 0;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		while (Halt !== 1'b1) begin&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			printCommand();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			// cpu clock sycle # 0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			printCycle(0);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			Clock = 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			Clock = 0;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;			// cpu clock sycle # 1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			printCycle(1);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			Clock = 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			Clock = 0;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;			// cpu clock sycle # 2&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			printCycle(2);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			Clock = 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			Clock = 0;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;			// cpu clock sycle # 3&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			printCycle(3);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			Clock = 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			Clock = 0;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			count = count + 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt; Command finished.");&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			printState();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			$display("^^^^^^^^^^^^^^^^^^^^^^^");&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;			#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;		#10;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		$display("Loop finished, count=%0d", count);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		$display("Halt=%d, Adr=%0h, outData=%0h, count=%0d", Halt, Adr, outData, count);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		printCommand();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		printMemory();&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		$display("=== Ending CPU_TestBench");&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		$finish;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	end&lt;/Paragraph&gt;&lt;Paragraph&gt;endmodule // CPU_TestBench&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;/FlowDocument&gt;</Note>
