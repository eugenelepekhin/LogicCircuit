		<Note>&lt;FlowDocument PagePadding="5,0,5,0" AllowDrop="True" NumberSubstitution.CultureSource="User" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"&gt;&lt;Paragraph&gt;; commands definition for small CPU&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;binary 16&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;macro r0 { 0 }&lt;/Paragraph&gt;&lt;Paragraph&gt;macro r1 { 1 }&lt;/Paragraph&gt;&lt;Paragraph&gt;macro r2 { 2 }&lt;/Paragraph&gt;&lt;Paragraph&gt;macro r3 { 3 }&lt;/Paragraph&gt;&lt;Paragraph&gt;macro r4 { 4 }&lt;/Paragraph&gt;&lt;Paragraph&gt;macro r5 { 5 }&lt;/Paragraph&gt;&lt;Paragraph&gt;macro r6 { 6 }&lt;/Paragraph&gt;&lt;Paragraph&gt;macro r7 { 7 }&lt;/Paragraph&gt;&lt;Paragraph&gt;macro r8 { 8 }&lt;/Paragraph&gt;&lt;Paragraph&gt;macro r9 { 9 }&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;macro ra { 10 }	macro r10 { ra }&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;macro rb { 11 }	macro r11 { rb }&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;macro rc { 12 }	macro r12 { rc }&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;macro rd { 13 }	macro r13 { rd }&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;macro re { 14 }	macro r14 { re }&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;macro rf { 15 }	macro r15 { rf }&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;macro _CheckRegister r {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(!(r0 &amp;lt;= r &amp;amp;&amp;amp; r &amp;lt;= rf)) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Invalid register: " + r&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;macro _COP cpuCop, aluCop, rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if (!(0b1000 &amp;lt;= cpuCop &amp;amp;&amp;amp; cpuCop &amp;lt;= 0b1111)) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Invalid CPU COP: " + cpuCop&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if (!(0 &amp;lt;= aluCop &amp;amp;&amp;amp; aluCop &amp;lt;= 0xF)) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Invalid ALU COP: " + aluCop&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_CheckRegister rSrc&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_CheckRegister rDst&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	(cpuCop &amp;lt;&amp;lt; 12) | (aluCop &amp;lt;&amp;lt; 8) | (rSrc &amp;lt;&amp;lt; 4) | rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Load Immediate. Loads provided value into r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro li value {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if (!(0 &amp;lt;= value &amp;amp;&amp;amp; value &amp;lt; 0x8000)) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Only positive 16 bits values are allowed in immediate command. Provided value is: " + value&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	value&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Loads immediate value in the register. Destroys r0 if r != r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro li value, r {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	value&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(r != r0) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		mov	r0, r&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Register movements&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Moves value in the source register to the destination&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro mov rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1001, 0, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Loads word from memory address in rAdr register to rDst register&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro mov [rAdr], rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1011, 0, rAdr, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Stores content of rSrc register to memory address in rAdr register&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro mov rSrc, [rAdr] {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1100, 0, rAdr, rSrc&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Saves IP to register&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro sip reg {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1101, 0, 0, reg&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; ALU operations&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rSrc | rDst -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro or rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0x0, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rSrc ^ rDst -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro xor rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0x1, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rSrc &amp;amp; rDst -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro and rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0x2, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rSrc + rDst -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro add rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0x3, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rSrc + rDst -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro adc rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0x4, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rDst - rSrc -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro sub rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0x5, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rDst - rSrc -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro sbc rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0x6, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rSrc &amp;lt;&amp;lt; 1 -&amp;gt; rDst (left shift)&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro shl rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0x7, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rSrc &amp;lt;&amp;lt; 1 | Carry -&amp;gt; rDst (left rotate)&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro rtl rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0x8, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rSrc &amp;gt;&amp;gt; 1 -&amp;gt; rDst (right shift)&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro shr rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0x9, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Carry &amp;gt;&amp;gt; rSrc &amp;gt;&amp;gt; 1 -&amp;gt; rDst (right rotate)&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro rtr rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0xA, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; sign(rSrc) -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro sgn rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0xB, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;atomic macro sl4 rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0xC, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; ~rSrc ^ rDst -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro xoN rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0xD, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; ~rSrc &amp;amp; rDst -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro anN rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0xE, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; rSrc + rDst + 1 -&amp;gt; rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro ad1 rSrc, rDst {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1010, 0xF, rSrc, rDst&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address in the register&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro jmp [reg] {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	; in jump commands instead of ALU COP provide jump mask&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1110, 0b1000, 0, reg&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address. Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro JMP address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jmp	[r0]&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address in the register if Zero flag is set to 1 (result is 0)&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro jz [reg] {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1110, 0b0111, 0, reg&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address if Zero flag is set to 1 (result is 0). Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro JZ address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jz	[r0]&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address in the register if Zero flag is set to 0 (result is not 0).&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro jnz [reg] {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1110, 0b0011, 0, reg&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address if Zero flag is set to 0 (result is not 0). Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro JNZ address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jnz	[r0]&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address in the register if Sign flag is set to 1 (negative result)&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro jn [reg] {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1110, 0b0110, 0, reg&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address if Negative flag is set to 1 (negative result). Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro JN address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jn	[r0]&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address in the register if Sign flag is set to 0 (positive result)&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro jp [reg] {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1110, 0b0010, 0, reg&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address if Negative flag is set to 0 (positive result). Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro JP address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jp	[r0]&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address in the register if Carry flag is set to 1&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro jc [reg] {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1110, 0b0100, 0, reg&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address if Carry flag is set to 1. Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro JC address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jc	[r0]&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address in the register if Carry flag is set to 0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro jnc [reg] {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1110, 0b0000, 0, reg&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address if Carry flag is set to 0. Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro JNC address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jnc	[r0]&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address in the register if Overflow flag is set to 1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;atomic macro jo	[reg] {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1110, 0b0101, 0, reg&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address if overflow flag is set to 1. Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro JO address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jo	[r0]&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address in the register if Overflow flag is set to 0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro jno [reg] {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1110, 0b0001, 0, reg&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Jumps to address if overflow flag is set to 0. Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro JNO address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jno	[r0]&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;atomic macro halt {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_COP 0b1111, 0, 0, 0&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;;;; Some commonly used macros&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Makes int 16 in memory&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro int16 value {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	value &amp;amp; 0xFFFF&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Makes int 32 in memory&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro int32 value {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	int16	value&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	int16	(value &amp;gt;&amp;gt; 16)&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; loads 16 bit value stored in memory by address in the register r. Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro LD address, r {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov	[r0], r&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; loads 32 bit value store by address in the pair of registers r and r + 1. Destroys r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro LD32 address, r {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	LD	address + 1, r + 1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	LD	address, r&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Stores register in memory by address. Destroys r0 and can't store r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro ST r, address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(r == r0) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Can't store r0"&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	address, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov	r, [r0]&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; stores pair or registers r and r + 1 to memory by address and address + 1. Destroys r0 and can't store r0&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro ST32 r, address {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	ST	r, address&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	ST	r + 1, address + 1&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Moves pair of registers a, a + 1 to pair of registers b, b + 1. Registers can't adjacent.&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro mov32 a, b {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(-1 &amp;lt;= (a - b) &amp;amp;&amp;amp; (a - b) &amp;lt;= 1) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Can't move pair of registers " + a + ", " + (a + 1) + " to " + b + ", " + (b + 1) + "."&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov	a, b&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov	a + 1, b + 1&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; (a, a + 1) + (b, b + 1) =&amp;gt; (b, b + 1)&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro add32 a, b {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(a != b &amp;amp;&amp;amp; -1 &amp;lt;= (a - b) &amp;amp;&amp;amp; (a - b) &amp;lt;= 1) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Can't add pair of registers " + a + ", " + (a + 1) + " and " + b + ", " + (b + 1) + "."&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	add	a, b&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	adc	a + 1, b + 1&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; (b, b + 1) - (a, a + 1) =&amp;gt; (b, b + 1)&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro sub32 a, b {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(a != b &amp;amp;&amp;amp; -1 &amp;lt;= (a - b) &amp;amp;&amp;amp; (a - b) &amp;lt;= 1) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Can't subtract pair of registers " + a + ", " + (a + 1) + " and " + b + ", " + (b + 1) + "."&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sub	a, b&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sbc	a + 1, b + 1&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; (r, r + 1) &amp;lt;&amp;lt;= 1&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro shl32 r {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	shl	r, r&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	rtl	r + 1, r + 1&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; (r, r + 1) &amp;gt;&amp;gt;= 1&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro shr32 r {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	shr	r + 1, r + 1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	rtr	r, r&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;atomic macro xor32 a, b {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(a != b &amp;amp;&amp;amp; -1 &amp;lt;= (a - b) &amp;amp;&amp;amp; (a - b) &amp;lt;= 1) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Can't XOR pair of registers " + a + ", " + (a + 1) + " and " + b + ", " + (b + 1) + "."&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	xor	a, b&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	xor	a + 1, b + 1&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;atomic macro or32 a, b {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(a != b &amp;amp;&amp;amp; -1 &amp;lt;= (a - b) &amp;amp;&amp;amp; (a - b) &amp;lt;= 1) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Can't OR pair of registers " + a + ", " + (a + 1) + " and " + b + ", " + (b + 1) + "."&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	or	a, b&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	or	a + 1, b + 1&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;atomic macro and32 a, b {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(a != b &amp;amp;&amp;amp; -1 &amp;lt;= (a - b) &amp;amp;&amp;amp; (a - b) &amp;lt;= 1) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Can't AND pair of registers " + a + ", " + (a + 1) + " and " + b + ", " + (b + 1) + "."&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	and	a, b&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	and	a + 1, b + 1&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; -(r, r + 1) =&amp;gt; (r, r + 1). Destroys r0 and can't negate r0.&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro neg32 r {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(r == r0) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		error "Cannot negate registers r0, r1"&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	0, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	xoN	r0, r			; ~r0 xor r -&amp;gt; r&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	xoN	r0, r + 1		; ~r0 xor r + 1 -&amp;gt; r + 1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	ad1	r0, r			; (r) + 1 -&amp;gt; r&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	adc	r0, r + 1&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; A(r4, r5) * B(r6, r7) =&amp;gt; Result(r8, r9)&lt;/Paragraph&gt;&lt;Paragraph&gt;; uses and destroys r0, r2, r3, r4, r5, r6, r7&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro Mul32 {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	xor32	r8, r8		; Result = 0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	mov		r4, r0		; if(A == 0)&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	or		r5, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	JZ		end			; goto end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	li		loop, r2	; r2: loop&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li		skip, r3	; r3: skip&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	JMP		while&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;loop:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	shr32	r4			; get low bit of A in carry&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jnc		[r3]		; skip adding if there is no carry&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	add32	r6, r8		; R += B&lt;/Paragraph&gt;&lt;Paragraph&gt;skip:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	shl32	r6			; B &amp;lt;&amp;lt;= 1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;while:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov		r6, r0		; loop while r6,r7 not 0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	or		r7, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jnz		[r2]		; loop&lt;/Paragraph&gt;&lt;Paragraph&gt;end:&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Restoring Division Algorithm For Unsigned Integer&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;	// dividend / divisor =&amp;gt; quotient, remainder&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;	static void RestoringDivision(int dividend, int divisor, out int quotient, out int remainder) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;		Debug.Assert(0 &amp;lt;= dividend);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;		Debug.Assert(0 &amp;lt; divisor);&lt;/Paragraph&gt;&lt;Paragraph&gt;;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;		int rem = 0;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;		int quot = dividend;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;		int n = 32;&lt;/Paragraph&gt;&lt;Paragraph&gt;;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;		do {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;			// first shift left concatenation of rem &amp;amp; quot: (rem quot) &amp;lt;&amp;lt; 1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;			rem &amp;lt;&amp;lt;= 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;			if(quot &amp;lt; 0) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;				rem |= 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;			}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;			quot &amp;lt;&amp;lt;= 1;&lt;/Paragraph&gt;&lt;Paragraph&gt;;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;			// check if 0 &amp;lt;= rem - divisor&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;			int temp = rem - divisor;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;			if(0 &amp;lt;= temp) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;				rem = temp;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;				quot |= 1;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;			}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;			n--;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;		} while (0 &amp;lt; n);&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;		quotient = quot;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;		remainder = rem;&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;;	}&lt;/Paragraph&gt;&lt;Paragraph&gt;; Div32: divisor(r4, r5), dividend(r6, r7) =&amp;gt; quotient(r6, r7) remainder(r8, r9).&lt;/Paragraph&gt;&lt;Paragraph&gt;;uses: r1(number 1), r2(cont 32), r3(keep sign of the result), (ra, rb (save remainder)), rc (loop label), rd (continue label)&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro Div32 {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	; extract sign of both operands and set them to absolute values as the algorithm only works with positive numbers.&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sgn		r5, r2			; get sign of divisor&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	JZ		positiveA&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	neg32	r4				; divisor is negative, so make it positive&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;positiveA:					; divisor now is positive and sign of divisor is in r2&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sgn		r7, r3			; get sign of dividend&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	JZ		positiveB&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	neg32	r6				; dividend is negative, so make it positive&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;positiveB:					; dividend is positive now with sign of dividend in r3&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	xor		r2, r3			; r3 = 0 if signs of both operands are equal and not 0 if signs are different&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	xor32	r8, r8			; remainder = 0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	li		1, r1			; r1 = 1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li		32, r2			; repeat 32 times&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li		loop, rc		; loop&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li		continue, rd	; continue&lt;/Paragraph&gt;&lt;Paragraph&gt;loop:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	shl		r6, r6			; left shift 4 register holding quotient and reminder r6, r7, r8, r9&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	rtl		r7, r7&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	rtl		r8, r8&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	rtl		r9, r9&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov32	r8, ra			; save remainder (r8, r9) in (ra, rb)&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sub32	r4, ra			; (ra, rb) = remainder - divisor&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jn		[rd]			; if remainder - divisor &amp;lt; 0 goto continue&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	or		r1, r6			; quotient |= 1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov32	ra, r8			; remainder = remainder - divisor&lt;/Paragraph&gt;&lt;Paragraph&gt;continue:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sub		r1, r2			; count--&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jnz		[rc]			; if 0 &amp;lt; count goto loop&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	; set correct sign of the result&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	or		r3, r3&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	JZ		end				; if signs of both operands were equal result is correct&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	neg32	r6				; otherwise negate the result&lt;/Paragraph&gt;&lt;Paragraph&gt;end:&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;macro _DigitAdjust r {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	;r1 mask&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	;r2	max&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	;r3	adjust&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov		r1, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	and		r, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sub		r2, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	JN		end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	add		r3, r&lt;/Paragraph&gt;&lt;Paragraph&gt;end:&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;macro _RegAdjust r, count {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	0xF, r1		;mask&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	0x5, r2		;max&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	0x3, r3		;adjust&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_DigitAdjust r&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sl4	r1, r1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sl4	r2, r2&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sl4	r3, r3&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_DigitAdjust r&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	if(count == 4) {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		sl4	r1, r1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		sl4	r2, r2&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		sl4	r3, r3&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		_DigitAdjust r&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		sl4	r1, r1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		sl4	r2, r2&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		sl4	r3, r3&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;		_DigitAdjust r&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	}&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; Double dabble algorithm&lt;/Paragraph&gt;&lt;Paragraph&gt;; Converts B(rb, rc) to BCD -&amp;gt; (r8, r9, ra)&lt;/Paragraph&gt;&lt;Paragraph&gt;; have to preserve (r4, r5) - number A, (r6, r7) - number B, rf&lt;/Paragraph&gt;&lt;Paragraph&gt;; uses: r0, r1, r2, r3, rd (sign of B), re (counter 31)&lt;/Paragraph&gt;&lt;Paragraph&gt;; https://www.youtube.com/watch?v=eXIfZ1yKFlA&amp;amp;t=8s&lt;/Paragraph&gt;&lt;Paragraph&gt;; https://en.wikipedia.org/wiki/Double_dabble&lt;/Paragraph&gt;&lt;Paragraph&gt;atomic macro Bin2BCD {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sgn		rc, rd		; get sign of B&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	JZ		positive	; if B is positive, go to positive&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	neg32	rb			; make copy of B positive&lt;/Paragraph&gt;&lt;Paragraph&gt;positive:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	xor		r8, r8		; BCD = 0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	xor		r9, r9&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	xor		ra, ra&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	li		31, re		; set up counter to 31 - to repeat 32 times&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; a little optimization: the B now is positive, so the sign bit and some high bits are 0, skip them&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li		1, r1		; number 1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li		start, r2	; start&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li		skip, r3	; skip&lt;/Paragraph&gt;&lt;Paragraph&gt;skip:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sub		r1, re		; count--&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jn		[r2]		; start&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	shl32	rb&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	jnc		[r3]		; skip until 1 in carry&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;start:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	rtl		r8, r8		; carry or not shift it in the r8. Note: the carry is not set if the skip loop exited by the counter &amp;lt; 0 which is happening when |B| == 0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;loop:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_RegAdjust r8, 4&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_RegAdjust r9, 4&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	_RegAdjust ra, 2&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	shl		rb, rb		; now shift all the BCD digits and B as a whole&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	rtl		rc, rc&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	rtl		r8, r8&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	rtl		r9, r9&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	rtl		ra, ra&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph xml:space="preserve"&gt;	li		1, r1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	sub		r1, re		; count--&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	JP		loop&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;; set sign of the BCD result&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	or		rd, rd		; check of sign of original B&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	JZ		end			; if B was positive, go to end&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	; else set sign bit in ra to 1 to denote negative number&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li		0x100, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	or		r0, ra		; set sign bit in ra&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;end:&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;/FlowDocument&gt;</Note>
