graph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov	[r0], r1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	halt&lt;/Paragraph&gt;&lt;Paragraph&gt;data:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	0xabcd&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;macro LoadSeflTest {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	data&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov	[r0], r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	halt&lt;/Paragraph&gt;&lt;Paragraph&gt;data:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	0xabcd&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;macro StoreTest {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	0x1234, r1&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	data&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	mov	r1, [r0]&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	halt&lt;/Paragraph&gt;&lt;Paragraph&gt;data:&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	0xabcd&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;macro XORtest {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	0x1357, r2&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	0x2468, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	xor	r0, r2		; expect 373F in r2&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	halt&lt;/Paragraph&gt;&lt;Paragraph&gt;}&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve" /&gt;&lt;Paragraph&gt;macro ORtest {&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	0x1357, r4&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	li	0x2468, r0&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	or	r0, r4		; 377F&lt;/Paragraph&gt;&lt;Paragraph xml:space="preserve"&gt;	halt&lt;/Paragraph&gt;&lt;Paragraph&gt;}&l